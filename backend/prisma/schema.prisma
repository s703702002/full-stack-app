generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  username String  @unique @db.VarChar(50)
  password String? @db.VarChar(255)
  name     String  @db.VarChar(50)
  email    String? @unique
  
  avatarUrl String? @map("avatar_url") @db.VarChar(500)
  coverUrl  String? @map("cover_url")
  bio       String? @db.VarChar(160)

  roleId Int? @map("role_id")

  // relations
  role           Role?          @relation(fields: [roleId], references: [id])
  posts          Post[]
  likedPosts     PostLike[]
  oauthAccounts  OAuthAccount[]
  twoFactorAuth  TwoFactorAuth?
  resetTokens    PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model TwoFactorAuth {
  id        String  @id @default(cuid())
  userId    String  @unique @map("user_id")
  secret    String  @db.VarChar(255)
  isEnabled Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id])

  @@map("two_factor_auth")
}

model OAuthAccount {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  provider   String // "google", "facebook", "apple"
  providerId String @map("provider_id")
  user       User   @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Post {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id") 
  content   String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  author User?      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  likes  PostLike[]

  @@map("posts")
}

model PostLike {
  userId    String   @map("user_id") 
  postId    String   @map("post_id") 
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId]) 
  @@map("post_likes")
}