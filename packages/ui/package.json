{
  "name": "@full-stack-app/ui",
  "version": "0.2.6",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils.ts",
    "./tailwind.css": "./src/tailwind.css",
    "./*": "./src/*/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build --clean && tsc --build --force",
    "dev": "tsc -w --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@full-stack-app/shared": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  }
}
