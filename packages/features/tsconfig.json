{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "composite": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "src/**/*.json", "./vitest.d.ts"],
  "exclude": ["node_modules", "dist"]
}
