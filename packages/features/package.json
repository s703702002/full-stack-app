{
  "name": "@full-stack-app/features",
  "version": "0.4.2",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./tailwind.css": "./src/tailwind.css",
    "./*": "./src/*/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build --clean && tsc --build --force",
    "dev": "tsc -w --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "axios": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@full-stack-app/shared": "workspace:*",
    "@full-stack-app/ui": "workspace:*",
    "i18next": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^26.0.0",
    "vitest": "catalog:",
    "vitest-axe": "^0.1.0"
  }
}
